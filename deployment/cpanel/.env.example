APP_ENV=production
APP_DEBUG=false
APP_URL=https://animus-api.intelpol.workers.dev
APP_KEY=BURAYA_EN_AZ_32_BYTE_RANDOM_SECRET
APP_TIMEZONE=Europe/Istanbul

SESSION_NAME=animus_loader_session
SESSION_SECURE=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_DB_ADI
DB_USERNAME=CPANEL_DB_KULLANICISI
DB_PASSWORD=BURAYA_CPANEL_MYSQL_SIFRESI

PATCH_STORAGE_PATH=storage/patches
LOADER_STORAGE_PATH=storage/loader
BRANDING_MEDIA_STORAGE_PATH=storage/media/branding
TRASH_STORAGE_PATH=storage/trash
TRASH_RETENTION_DAYS=14
UPLOAD_MAX_BYTES=1073741824
LOADER_UPLOAD_MAX_BYTES=2147483648
IMAGE_UPLOAD_MAX_BYTES=15728640
MAX_IMAGE_UPLOAD_SIZE=15728640
MAX_VIDEO_UPLOAD_SIZE=262144000
DOWNLOAD_TOKEN_TTL=300
RATE_LIMIT_PER_MINUTE=60

CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://animus-api.intelpol.workers.dev

MAIL_ENABLED=false
MAIL_FROM=no-reply@your-mail-domain.example

# Zorunlu indirme guvenligi (hesap kaydini etkinlestirmek icin posta gerekli)
# MAIL_ENABLED=true olmalı; sunucuda PHP mail()/sendmail teslimatı çalışmalıdır.
# MAIL_FROM=dogrulama@your-mail-domain.example
# https://discord.com/developers/applications -> OAuth2 -> Redirects:
# Discord OAuth2 Redirect URL: https://animus-api.intelpol.workers.dev/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Sunucu: https://discord.gg/RMP6gGHpKK
# Discord'un resmi davet API'sinden ID her istekte dogrulanir.
# DISCORD_GUILD_ID verilirse davetten gelen ID ile mutlaka ayni olmalidir.
# Davet silinir veya API ulasilamazsa koruma geregi indirme durur.
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
