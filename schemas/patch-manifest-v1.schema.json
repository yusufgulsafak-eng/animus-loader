{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/patch-manifest-v1.schema.json",
  "title": "Turkish Patch Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","game","detection","patch","archive","install_actions","integrity","backup"],
  "properties": {
    "schema_version": {"const": 1},
    "game": {"type":"object","additionalProperties":false,"required":["id","slug","name"],"properties":{"id":{"type":"integer","minimum":1},"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"name":{"type":"string","minLength":1,"maxLength":190}}},
    "detection": {"type":"object","additionalProperties":false,"required":["executable","required_files","optional_files"],"properties":{"steam_app_id":{"type":["string","null"],"pattern":"^[0-9]+$"},"epic_catalog_id":{"type":["string","null"],"maxLength":190},"executable":{"$ref":"#/$defs/safePath"},"process_name":{"type":["string","null"],"maxLength":255},"required_files":{"type":"array","items":{"$ref":"#/$defs/safePath"},"maxItems":1000},"optional_files":{"type":"array","items":{"$ref":"#/$defs/safePath"},"maxItems":1000}}},
    "patch": {"type":"object","additionalProperties":false,"required":["id","version","minimum_loader_version","mandatory","channel"],"properties":{"id":{"type":"integer","minimum":1},"version":{"$ref":"#/$defs/version"},"game_version":{"type":["string","null"],"maxLength":100},"minimum_loader_version":{"$ref":"#/$defs/version"},"mandatory":{"type":"boolean"},"channel":{"enum":["stable","beta","internal"]}}},
    "archive": {"type":"object","additionalProperties":false,"required":["download_token_url","sha256","size"],"properties":{"download_token_url":{"type":"string","format":"uri"},"sha256":{"$ref":"#/$defs/sha256"},"size":{"type":"integer","minimum":1}}},
    "install_actions": {"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/$defs/action"}},
    "integrity": {"type":"object","additionalProperties":false,"required":["verify_after_install","conflict_policy"],"properties":{"verify_after_install":{"type":"boolean"},"conflict_policy":{"const":"abort"}}},
    "backup": {"type":"object","additionalProperties":false,"required":["automatic","retain_until_uninstall"],"properties":{"automatic":{"const":true},"retain_until_uninstall":{"type":"boolean"}}}
  },
  "$defs": {
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "sha256":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"},
    "safePath":{"type":"string","minLength":1,"maxLength":1000,"pattern":"^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?![/\\\\]{2}).+$"},
    "action":{"type":"object","additionalProperties":false,"required":["id","type","destination","backup"],"properties":{"id":{"type":"string","format":"uuid"},"type":{"enum":["COPY_FILE","COPY_DIRECTORY","REPLACE_FILE","DELETE_FILE","DELETE_DIRECTORY","CREATE_DIRECTORY","MOVE_FILE","RENAME_FILE","APPEND_FAT_DAT"]},"source":{"oneOf":[{"$ref":"#/$defs/safePath"},{"type":"null"}]},"destination":{"$ref":"#/$defs/safePath"},"backup":{"type":"boolean"},"expected_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},"options":{"type":"object","additionalProperties":true}},"allOf":[{"if":{"properties":{"type":{"const":"APPEND_FAT_DAT"}}},"then":{"required":["source","options"],"properties":{"source":{"$ref":"#/$defs/safePath"},"backup":{"const":true},"options":{"type":"object","additionalProperties":false,"required":["fat_path","fat_entry_hash","base_dat_sha256","base_fat_sha256","payload_sha256","alignment","compression"],"properties":{"fat_path":{"$ref":"#/$defs/safePath"},"fat_entry_hash":{"type":"string","pattern":"^[a-fA-F0-9]{16}$"},"base_dat_sha256":{"$ref":"#/$defs/sha256"},"base_fat_sha256":{"$ref":"#/$defs/sha256"},"payload_sha256":{"$ref":"#/$defs/sha256"},"alignment":{"const":8},"compression":{"const":"none"}}}}}}]}
  }
}


